{
  "name": "agentforge",
  "displayName": "AgentForge",
  "description": "Local-first command center for versioned AI prompt blueprints.",
  "version": "0.2.1",
  "license": "0BSD",
  "publisher": "agentforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/LD-111/agentforge.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentforge",
          "title": "AgentForge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentforge": [
        {
          "type": "webview",
          "id": "agentforge.sidebar",
          "name": "Blueprints"
        }
      ]
    },
    "commands": [
      {
        "command": "agentforge.refresh",
        "title": "AgentForge: Refresh Blueprints",
        "icon": "$(refresh)"
      },
      {
        "command": "agentforge.compileBlueprint",
        "title": "AgentForge: Compile Blueprint"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentforge.refresh",
          "when": "view == agentforge.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.11",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
